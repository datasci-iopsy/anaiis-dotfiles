# OS
.DS_Store

# Never commit machine-specific or sensitive files
*.local
*.env
*.env.*
!.env.example
*credentials*
*secret*
*.pem
*.key

# Machine-local Claude rule files (see claude/rules/context.md)
claude/rules/*.local.md

# Global memory is a local folder in each profile (~/.claude/memory); a copy placed here stays out of git
claude/memory/

# Local Claude session artifacts
.claude/

# vscode
.vscode/

# Homebrew bundle lockfile (regenerated on every install; not pinned)
Brewfile.lock.json

# Misc
_archive

# Planning artifacts: spec/ and tasks/ exist only in the main checkout (see claude/rules/work-tracking.md)
spec/
tasks/

# Plugin eval runs: result JSON, HTML reports, kept workspaces, and the
# per-machine symlink to the cached plugin under test
evals/**/results/
evals/ponytail/plugin
# Generated by evals/ponytail/build-rules-prompt.sh from case.yaml.tmpl and claude/rules/
evals/ponytail/rules/
evals/ponytail/evals/*/case.yaml
tmp/
# OS
.DS_Store

# Never commit machine-specific or sensitive files
*.local
*.env
*.env.*
!.env.example
*credentials*
*secret*
*.pem
*.key

# Local Claude session artifacts
.claude/

# vscode
.vscode/

# Vendored Python environments (machine-local, reproducible from submodule)
vendor/graphify-venv/

# Homebrew bundle lockfile (regenerated on every install; not pinned)
Brewfile.lock.json

# Misc
_archive

# Ephemeral planning artifacts (persisted in ~/.claude/plans/ instead)
spec/
tasks/

# Plugin eval runs: result JSON, HTML reports, kept workspaces, and the
# per-machine symlink to the cached plugin under test
evals/**/results/
evals/ponytail/plugin
# Generated by evals/ponytail/build-rules-prompt.sh from case.yaml.tmpl and claude/rules/
evals/ponytail/rules/
evals/ponytail/evals/*/case.yaml
tmp/
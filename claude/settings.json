{
    "skillListingBudgetFraction": 0.05,
    "env": {
        "GIT_AUTHOR_NAME": "datasci-iopsy",
        "GIT_AUTHOR_EMAIL": "14611107+datasci-iopsy@users.noreply.github.com",
        "GIT_COMMITTER_NAME": "datasci-iopsy",
        "GIT_COMMITTER_EMAIL": "14611107+datasci-iopsy@users.noreply.github.com"
    },
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "permissions": {
        "allow": [
            "Read",
            "WebSearch",
            "WebFetch(domain:docs.coderabbit.ai)",
            "Bash(git:*)",
            "Bash(git -C *)",
            "Bash(ALLOW_LOCK_COMMIT=1 git commit*)",
            "Bash(python:*)",
            "Bash(python3:*)",
            "Bash(ls:*)",
            "Bash(cd:*)",
            "Bash(tree:*)",
            "Bash(wc:*)",
            "Bash(diff:*)",
            "Bash(sort:*)",
            "Bash(uniq:*)",
            "Bash(cut:*)",
            "Bash(file:*)",
            "Bash(which:*)",
            "Bash(date:*)",
            "Bash(make:*)",
            "Bash(gh:*)",
            "Bash(jq:*)",
            "Bash(duckdb:*)",
            "Bash(textutil:*)",
            "Bash(coderabbit:*)",
            "Bash(graphify:*)",
            "Bash(direnv:*)",
            "Bash(uv:*)",
            "Bash(uvr:*)",
            "Bash(tmux capture-pane *)",
            "Bash(dbt parse *)",
            "Bash(dbt compile *)",
            "Bash(bq show *)",
            "Bash(bq ls *)",
            "Bash(bq ls)",
            "Bash(bq query *)",
            "Bash(bq head *)",
            "Bash(bq version)",
            "Bash(gcloud auth list)",
            "Bash(gcloud config *)",
            "Bash(gcloud projects list *)",
            "Bash(gcloud projects describe *)",
            "Bash(gcloud * list *)",
            "Bash(gcloud * describe *)"
        ],
        "deny": [
            "Bash(rm -r*)",
            "Bash(rm -fr*)",
            "Bash(rm -R*)",
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git clean -f*)",
            "Bash(gh repo delete*)",
            "Bash(gh auth logout*)",
            "Bash(sudo *)",
            "Bash(brew uninstall*)",
            "Bash(brew remove*)",
            "Bash(pip install*)",
            "Bash(pip uninstall*)",
            "Bash(pip3 install*)",
            "Bash(pip3 uninstall*)",
            "Bash(uv pip install*)",
            "Bash(uv add*)",
            "Bash(docker rm*)",
            "Bash(docker rmi*)",
            "Bash(docker system prune*)",
            "Bash(kubectl delete*)",
            "Bash(terraform apply*)",
            "Bash(terraform destroy*)",
            "Read(**/.env*)",
            "Edit(**/.env*)",
            "Read(**/*.key)",
            "Edit(**/*.key)",
            "Read(**/*.pem)",
            "Edit(**/*.pem)",
            "Read(**/*credentials*)",
            "Edit(**/*credentials*)",
            "Read(**/secrets/**)",
            "Edit(**/secrets/**)",
            "Read(**/.ssh/**)",
            "Edit(**/.ssh/**)",
            "Read(~/.bashrc)",
            "Edit(~/.bashrc)",
            "Read(~/.bashrc.local)",
            "Edit(~/.bashrc.local)",
            "Read(~/.bash_profile)",
            "Edit(~/.bash_profile)",
            "Read(~/.zshrc)",
            "Edit(~/.zshrc)",
            "Read(~/.zshrc.local)",
            "Edit(~/.zshrc.local)",
            "Read(~/.profile)",
            "Edit(~/.profile)",
            "Read(~/.aws/**)",
            "Edit(~/.aws/**)",
            "Read(~/.config/gcloud/**)",
            "Edit(~/.config/gcloud/**)",
            "Read(~/.config/secrets/**)",
            "Edit(~/.config/secrets/**)",
            "Read(~/.netrc)",
            "Edit(~/.netrc)",
            "Read(~/.gnupg/**)",
            "Edit(~/.gnupg/**)",
            "Read(~/.docker/**)",
            "Edit(~/.docker/**)",
            "Read(~/.kube/**)",
            "Edit(~/.kube/**)",
            "Read(~/.npmrc)",
            "Edit(~/.npmrc)",
            "Read(~/.pypirc)",
            "Edit(~/.pypirc)",
            "Read(~/.config/gh/**)",
            "Edit(~/.config/gh/**)"
        ],
        "defaultMode": "default",
        "disableAutoMode": "disable"
    },
    "skillOverrides": {
        "dbt:configuring-dbt-mcp-server": "user-invocable-only",
        "dbt:working-with-dbt-mesh": "off"
    },
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/maintenance-check.sh"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/ensure-repo-hooks.sh"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/list-merged-claude-branches.sh"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/session-start-context.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/post-edit-lint.sh"
                    }
                ]
            },
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/context-watch.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/block-em-dash.sh"
                    },
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/block-edit-on-main.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/block-sensitive-writes.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/bash-guard.sh"
                    },
                    {
                        "type": "command",
                        "command": "rtk hook claude"
                    }
                ]
            },
            {
                "matcher": "Agent|WebFetch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/cost-guard.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/stop-hook-git-check.sh"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/.claude/hooks/pre-compact.sh"
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "bash $HOME/.claude/scripts/statusline-command.sh"
    },
    "enabledPlugins": {
        "frontend-design@claude-plugins-official": true,
        "anaiis-review@anaiis-plugins": true,
        "anaiis-git-ops@anaiis-plugins": true,
        "anaiis-data@anaiis-plugins": true,
        "anaiis-writing@anaiis-plugins": true,
        "anaiis-meta@anaiis-plugins": true,
        "dbt@dbt-agent-marketplace": true,
        "dbt-extras@dbt-agent-marketplace": true,
        "agent-skills@addy-agent-skills": true
    },
    "extraKnownMarketplaces": {
        "anaiis-plugins": {
            "source": {
                "source": "github",
                "repo": "datasci-iopsy/anaiis-plugins"
            }
        },
        "dbt-agent-marketplace": {
            "source": {
                "source": "github",
                "repo": "dbt-labs/dbt-agent-skills"
            }
        },
        "addy-agent-skills": {
            "source": {
                "source": "github",
                "repo": "addyosmani/agent-skills"
            }
        }
    },
    "skipDangerousModePermissionPrompt": true,
    "autoCompactEnabled": true
}
